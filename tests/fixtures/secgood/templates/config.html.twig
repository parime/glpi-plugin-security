{# Version correcte (issue #22) : réglages seulement ; la lecture et ses résultats sont dans Outils. #}
<form method="post" action="config.php">
  <input type="url" name="url" class="form-control">
  <button type="submit" name="test" class="btn btn-outline-secondary">{{ __('Tester la connexion', 'secgood') }}</button>
  <table class="table">
    {% for source in sources %}
      <tr><td>{{ source.name }}</td><td><input type="number" name="threshold[{{ source.id }}]"></td></tr>
    {% endfor %}
  </table>
  <p>{{ __('La lecture se lance depuis Outils > secgood, qui affiche aussi son résultat.', 'secgood') }}</p>
  <button type="submit" name="save" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
</form>
